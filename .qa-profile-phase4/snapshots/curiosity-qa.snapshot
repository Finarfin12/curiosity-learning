tline: 2px solid var(--interactive-accent); }\n.cl-axes, .cl-comparison { display: grid; gap: var(--size-4-2); }\n.cl-axes { grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); }\n.cl-axes > div, .cl-comparison > div { min-width: 0px; border: 1px solid var(--background-modifier-border); border-radius: var(--radius-s); padding: var(--size-4-2); }\n.cl-axes span { display: block; color: var(--text-muted); }\n.cl-comparison { grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); }\n.cl-text { white-space: pre-wrap; overflow-wrap: anywhere; }\n.cl-queue meter { width: 100%; accent-color: var(--interactive-accent); }\n.cl-evidence-result { padding: var(--size-4-3); margin-block: var(--size-4-2); border: 1px solid var(--background-modifier-border); border-radius: var(--radius-s); overflow-wrap: anywhere; }\n.cl-prereqs { padding-inline-start: var(--size-4-4); }\n.cl-prereqs li { margin-block: var(--size-4-2); }\n.cl-prereqs button { margin-inline-start: var(--size-4-2); white-space: normal; }\n.cl-prereq-warn { color: var(--text-warning); font-weight: 600; }\n.cl-prereq-ready { color: var(--text-muted); }\n.cl-ai-preview { max-height: 18rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; }\n.modal.cl-modal-wide { width: min(720px, 92vw); max-width: 92vw; }\n.cl-textarea-setting.setting-item { flex-direction: column; align-items: stretch; gap: var(--size-4-2); }\n.cl-textarea-setting .setting-item-info { margin: 0px; }\n.cl-textarea-setting .setting-item-control { width: 100%; }\n.cl-textarea-setting textarea { width: 100%; min-height: 8.5rem; resize: vertical; font-family: inherit; line-height: 1.5; padding: var(--size-4-2); }\n.cl-textarea-setting textarea.cl-textarea-long { min-height: 10rem; }\n.cl-ai-context { display: grid; gap: var(--size-4-3); margin-block: var(--size-4-4); }\n.cl-ai-context > div { border: 1px solid var(--background-modifier-border); border-radius: var(--radius-m); padding: var(--size-4-3); }\n.cl-ai-con